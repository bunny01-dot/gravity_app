rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Canonical teacher email allowlist (fallback when custom claims are absent).
    function isTeacherEmail() {
      return isSignedIn() &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('(?i)^teacher@english\\.com$');
    }

    // Helper function to check if user is a teacher.
    // Priority:
    // 1) Custom claims
    // 2) Teacher email allowlist
    // 3) Existing users/{uid}.role value (legacy compatibility)
    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.role == 'teacher' ||
        request.auth.token.admin == true ||
        isTeacherEmail() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        )
      );
    }

    // Owners cannot self-escalate privileges or modify teacher-controlled flags.
    function ownerCanUpdateOwnUserDoc(userId) {
      return isOwner(userId) &&
             request.resource.data.uid == userId &&
             (
               request.resource.data.email == resource.data.email ||
               (
                 resource.data.email == null &&
                 request.auth.token.email != null &&
                 request.resource.data.email == request.auth.token.email
               )
             ) &&
             request.resource.data.role == resource.data.role &&
             !request.resource.data
               .diff(resource.data)
               .changedKeys()
               .hasAny([
                 'role',
                 'isBlocked',
                 'force_onboarding',
                 'proficiency_changed_by_teacher',
                 'proficiency_changed_at',
                 'blockedAt',
                 'blockedBy',
                 'blockedReason',
                 'fcmToken',
                 'lastTokenUpdate',
               ]);
    }

    // Users collection
    match /users/{userId} {
      // Signed-in users can read profile data used by app features
      // (leaderboard, classmate lookup, teacher dashboards).
      allow read: if isSignedIn();

      // Users can only create their own profile during signup
      allow create: if isOwner(userId) &&
                       request.resource.data.uid == userId &&
                       request.auth.token.email != null &&
                       request.resource.data.email == request.auth.token.email &&
                       !request.resource.data.keys().hasAny([
                         'fcmToken',
                         'lastTokenUpdate',
                       ]) &&
                       (
                         request.resource.data.role == 'student' ||
                         (request.resource.data.role == 'teacher' && isTeacherEmail())
                       );

      // Owners can update non-privileged fields.
      // Teachers can update any user fields for moderation/admin actions.
      allow update: if ownerCanUpdateOwnUserDoc(userId) || isTeacher();

      // Only teachers can delete users
      allow delete: if isTeacher();

      // User progress subcollection
      match /progress/{progressId} {
        allow read: if isOwner(userId) || isTeacher();
        allow write: if isOwner(userId);
        // Delete allowed for teachers (reset progress)
        allow delete: if isTeacher();
      }

      // User activity logs
      match /activity/{activityId} {
        allow read: if isOwner(userId) || isTeacher();
        allow create: if isOwner(userId);
        allow update, delete: if false; // Activity logs are immutable
      }

      // Per-user notification history
      match /notification_history/{historyId} {
        allow read, create, update, delete: if isOwner(userId) || isTeacher();
      }

      // Lesson progress (Storybooks & Quizzes)
      match /lessons/{lessonId} {
        allow read: if isOwner(userId) || isTeacher();
        allow write: if isOwner(userId);
      }

      // Curriculum progress (Menu Quizzes)
      match /curriculum_progress/{docId} {
        allow read: if isOwner(userId) || isTeacher();
        allow write: if isOwner(userId);
      }

      // Daily learning records (Vocabulary/Verbs)
      match /learning_records/{recordId} {
        allow read: if isOwner(userId) || isTeacher();
        allow write: if isOwner(userId);
      }

      // Notifications subcollection (Used by Teacher to send alerts)
      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isTeacher();
        allow create: if isTeacher();
        allow update, delete: if isTeacher(); // Owners mask via prefs, don't delete
      }

      // Private per-user metadata (device tokens, internal diagnostics, etc.)
      // Keep secrets out of users/{uid} root docs so profile reads remain safe.
      match /private/{privateDocId} {
        allow read, write: if isOwner(userId) || isTeacher();
      }
    }

    // Announcements collection
    match /announcements/{announcementId} {
      // Signed-in users can read announcements
      allow read: if isSignedIn();

      // Only teachers can create/update/delete announcements
      allow write: if isTeacher();
    }

    // Attendance collection
    match /attendance/{docId} {
      // Teachers can read all attendance
      allow read: if isTeacher();

      // Students can access only their own attendance records.
      // Supports both:
      // 1) Canonical doc id pattern: {date}_{uid}
      // 2) Legacy .add() writes keyed by studentEmail
      allow read: if isSignedIn() && (
        docId.matches('^.*_' + request.auth.uid + '$') ||
        resource.data.studentId == request.auth.uid ||
        (
          request.auth.token.email != null &&
          resource.data.studentEmail == request.auth.token.email
        )
      );

      allow create: if isSignedIn() && (
        docId.matches('^.*_' + request.auth.uid + '$') ||
        request.resource.data.studentId == request.auth.uid ||
        (
          request.auth.token.email != null &&
          request.resource.data.studentEmail == request.auth.token.email
        )
      );

      allow update: if isTeacher() || (
        isSignedIn() && (
          docId.matches('^.*_' + request.auth.uid + '$') ||
          resource.data.studentId == request.auth.uid
        )
      );

      // Teachers can delete attendance
      allow delete: if isTeacher();
    }

    // Feedback collection
    match /feedback/{feedbackId} {
      // Teachers can read all feedback
      // Students can only read their own
      allow read: if isTeacher() ||
                     (
                       isSignedIn() && (
                         resource.data.userId == request.auth.uid ||
                         resource.data.studentId == request.auth.uid ||
                         (
                           request.auth.token.email != null &&
                           (
                             resource.data.userEmail == request.auth.token.email ||
                             resource.data.studentEmail == request.auth.token.email
                           )
                         )
                       )
                     );

      // Students can create feedback
      allow create: if isSignedIn();

      // Only teachers can update/delete feedback
      allow update, delete: if isTeacher();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Teachers can read all for moderation.
      // Users can read their own notifications.
      allow read: if isTeacher() ||
                     (isSignedIn() && resource.data.userId == request.auth.uid);

      // Teachers can create notifications.
      // Students may create teacher-targeted alert docs with their own senderId.
      allow create: if isTeacher() ||
                       (
                         isSignedIn() &&
                         request.resource.data.senderId == request.auth.uid
                       );

      // Users can update their own notifications (mark as read)
      allow update: if isTeacher() ||
                       (
                         isSignedIn() &&
                         resource.data.userId == request.auth.uid &&
                         request.resource.data.userId == request.auth.uid
                       );

      // Teachers can delete notifications
      allow delete: if isTeacher();
    }

    // Teacher Notifications collection
    match /teacher_notifications/{notificationId} {
      // Teachers can read/update/delete all
      allow read, update, delete: if isTeacher();

      // Students can only create notifications about themselves.
      allow create: if isSignedIn() && (
                       isTeacher() ||
                       request.resource.data.senderId == request.auth.uid ||
                       request.resource.data.studentId == request.auth.uid ||
                       request.resource.data.student_id == request.auth.uid
                     );
    }

    // Quiz results collection
    match /quiz_results/{resultId} {
      // Teachers can read all results
      // Students can only read their own
      allow read: if isTeacher() ||
                     (isSignedIn() && resource.data.userId == request.auth.uid);

      // Students can create their own quiz results
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Quiz results are immutable once created
      allow update, delete: if false;
    }

    // Game scores collection
    match /game_scores/{scoreId} {
      // Teachers can read all scores
      // Students can only read their own
      allow read: if isTeacher() ||
                     (isSignedIn() && resource.data.userId == request.auth.uid);

      // Students can create their own scores
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Scores can only be updated if new score is higher
      allow update: if isSignedIn() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.score >= resource.data.score;

      allow delete: if false; // Scores are permanent
    }

    // Content library (vocabulary, grammar, etc.)
    match /content/{contentType}/{itemId} {
      // Signed-in users can read content
      allow read: if isSignedIn();

      // Only teachers can manage content
      allow write: if isTeacher();
    }

    // Library Content (Custom vocabulary, verbs, etc. uploaded by teachers)
    match /library_content/{docId} {
      // All authenticated users can read custom content
      allow read: if isSignedIn();

      // Only teachers can create/update custom content
      allow create, update: if isTeacher();

      // Only teachers can delete custom content
      allow delete: if isTeacher();
    }

    // System Awards (Student of the Week)
    match /system/awards {
      allow read: if isSignedIn();
      allow write: if isTeacher();

      match /history/{historyId} {
        allow read: if isSignedIn();
        allow write: if isTeacher();
      }
    }

    // Bug Reports
    match /bug_reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isTeacher() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isTeacher();
    }

    // Client-side notification validation/error events
    match /notification_errors/{errorId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isTeacher();
    }

    // Notification delivery logs (for monitoring)
    match /notification_logs/{logId} {
      // Only Cloud Functions can write
      allow create: if false;

      // Teachers and admins can read
      allow read: if isTeacher();

      // No updates or deletes allowed
      allow update, delete: if false;
    }

    // Application errors log (for debugging)
    match /app_errors/{errorId} {
      // Students can create error logs
      allow create: if isSignedIn();

      // Only teachers can read/manage error logs
      allow read, update, delete: if isTeacher();
    }

    // Word Duel Matches (Multiplayer)
    match /matches/{matchId} {
      // Only match players can read
      allow read: if isSignedIn() && request.auth.uid in resource.data.players;

      // All writes are server-side via Cloud Functions (never trust client input)
      allow create, update, delete: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
